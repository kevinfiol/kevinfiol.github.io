<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
    <title><%= site.title %></title>
    <link rel="self" type="application/atom+xml" href="<%= site.url %>atom.xml"/>
    <link rel="alternate" type="text/html" href="<%= site.url %>"/>
    <% local posts = sortedPosts(items) -%>
    <updated><%= posts[1].date %>T00:00:00+00:00</updated>
    <id><%= site.url %>atom.xml</id>
    <% for _, post in ipairs(posts) do -%>
        <% local link = site.url .. string.sub(post.permalink, 2) -%>
        <entry xml:lang="en">
            <title><%= post.title %></title>
            <published><%= post.date %>T00:00:00+00:00</published>
            <updated><%= post.date %>T00:00:00+00:00</updated>
            <link rel="alternate" type="text/html" href="<%= link %>"/>
            <id><%= link %></id>
            <content type="html" xml:base="<%= link %>"><%= post.content %></content>
        </entry>
    <% end -%>
</feed>
